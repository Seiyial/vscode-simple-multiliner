{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2020",
		"outDir": "out",
		"moduleResolution": "bundler",
		"lib": [
			"es6"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		"types": [
			"node"
		],
		"skipLibCheck": true,
		/* Additional Checks */
		// "noImplicitReturns": true, /* Report error when not all code paths return a value. */
		// "noFallthroughCasesInSwitch": true, /* Report errors when errors in switch statements are not caught. */
		// "noUnusedParameters": true,  /* Report errors on unused parameters. */
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	],
	"include": [
		"src"
	]
}
